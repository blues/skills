{
  "openapi": "3.0.3",
  "info": {"title": "Json", "version": "2.0"},
  "paths": {
    "/zebras": {
      "post": {
        "operationId": "AddZebra",
        "summary": "Register a zebra",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {
            "type": "object",
            "required": ["stripes"],
            "properties": {"stripes": {"type": "integer"}, "name": {"type": "string"}}
          }}}
        },
        "responses": {"201": {"description": "created"}}
      },
      "get": {
        "operationId": "ListZebras",
        "summary": "List zebras",
        "responses": {"200": {"description": "ok"}}
      }
    }
  }
}
